# ── Local development ────────────────────────────────────────────
# Copy to .env if you override Compose. NEVER commit a real .env.
# These values match infrastructure/compose.yaml defaults.

POSTGRES_DB=kiosk
POSTGRES_USER=kiosk
POSTGRES_PASSWORD=kiosk-dev-password

REDIS_PORT=6379

MINIO_ROOT_USER=local-minio-admin
MINIO_ROOT_PASSWORD=local-minio-password-change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=kiosk-content

# API (launchSettings.json uses 5163 — keep Vite proxy in sync)
API_PORT=5163
API_URLS=http://localhost:5163

# Admin web
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:5163
