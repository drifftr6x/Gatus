# ── Local development environment ────────────────────────────────
# Copy this file to .env and adjust values for your local setup.
# NEVER commit a real .env file to source control.
# NEVER use these example values in any non-local environment.

# PostgreSQL (local development only)
POSTGRES_DB=kiosk_platform
POSTGRES_USER=kiosk_platform
POSTGRES_PASSWORD=local-dev-password-change-me

# Redis
REDIS_PORT=6379

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=local-minio-admin
MINIO_ROOT_PASSWORD=local-minio-password-change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=kiosk-content

# API server
API_PORT=5000
API_URLS=http://localhost:5000
CONNECTION_STRING=Host=localhost;Port=5432;Database=kiosk_platform;Username=kiosk_platform;Password=local-dev-password-change-me

# Admin web (Vite dev server)
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:5000
